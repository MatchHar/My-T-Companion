# Example unified LAN gateway. My T uses ONE base_url (this listen address).
# Replace the listen address and TeslaMateAPI upstream for your host.
#
# Companion paths → 127.0.0.1:8083
# Everything else under /api → stock TeslaMateAPI (example: host-mapped 8081)
http://192.168.1.10:8080 {
	# Keep owner authentication when placing this matcher behind an HTTPS gateway.
	# Friend guest routes are NOT part of this existing owner/API site.
	@my_t_companion path_regexp my_t_companion ^/api/v1/(capabilities|cars/[0-9]+/states|cars/[0-9]+/parking-events|cars/[0-9]+/companion-status|cars/[0-9]+/navigation/current-drive|cars/[0-9]+/navigation/push-history|notifications/.*|friend-together/.*)$
	handle @my_t_companion {
		reverse_proxy 127.0.0.1:8083
	}

	handle {
		reverse_proxy 127.0.0.1:8081
	}
}
